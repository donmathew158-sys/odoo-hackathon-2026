<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_brightloop_plan_list" model="ir.ui.view">
        <field name="name">brightloop.plan.list</field>
        <field name="model">brightloop.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="interval"/>
                <field name="price"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="view_brightloop_plan_form" model="ir.ui.view">
        <field name="name">brightloop.plan.form</field>
        <field name="model">brightloop.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="price"/>
                            <field name="interval"/>
                            <field name="min_quantity"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="auto_close"/>
                            <field name="allow_early_close"/>
                            <field name="allow_pause"/>
                            <field name="allow_renew"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brightloop_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">brightloop.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_brightloop_root" name="Brightloop"
              groups="group_brightloop_staff" sequence="10"/>
    <menuitem id="menu_brightloop_plans" name="Plans"
              parent="menu_brightloop_root"
              action="action_brightloop_plan" sequence="10"/>
</odoo>
