<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_brightloop_plan_list" model="ir.ui.view">
        <field name="name">brightloop.plan.list</field>
        <field name="model">brightloop.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id" optional="show"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="interval" widget="badge"/>
                <field name="min_quantity" optional="show"/>
                <field name="allow_pause" widget="boolean_toggle" optional="show"/>
                <field name="allow_early_close" widget="boolean_toggle" optional="hide"/>
                <field name="allow_renew" widget="boolean_toggle" optional="show"/>
                <field name="auto_close" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_brightloop_plan_form" model="ir.ui.view">
        <field name="name">brightloop.plan.form</field>
        <field name="model">brightloop.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Pro Monthly"/></h1>
                    </div>
                    <group>
                        <group string="Pricing">
                            <field name="product_id"/>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id"/>
                            <field name="interval"/>
                            <field name="min_quantity"/>
                        </group>
                        <group string="Validity">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Plan Rules">
                        <group>
                            <field name="allow_pause" widget="boolean_toggle"/>
                            <field name="allow_early_close" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="allow_renew" widget="boolean_toggle"/>
                            <field name="auto_close" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_brightloop_plan_search" model="ir.ui.view">
        <field name="name">brightloop.plan.search</field>
        <field name="model">brightloop.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <filter name="f_pause" string="Allows Pause" domain="[('allow_pause', '=', True)]"/>
                <filter name="f_renew" string="Allows Renewal" domain="[('allow_renew', '=', True)]"/>
                <separator/>
                <filter name="f_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_interval" string="Billing Interval" context="{'group_by': 'interval'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_brightloop_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">brightloop.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first plan</p>
            <p>A plan defines the price, billing interval and rules for a subscription.</p>
        </field>
    </record>

    <menuitem id="menu_brightloop_root" name="Brightloop" sequence="10"
              groups="group_brightloop_staff,group_brightloop_admin"/>
    <menuitem id="menu_brightloop_plans" name="Plans" parent="menu_brightloop_root"
              action="action_brightloop_plan" sequence="20"
              groups="group_brightloop_staff,group_brightloop_admin"/>
</odoo>