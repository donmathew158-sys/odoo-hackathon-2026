<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_brightloop_template_list" model="ir.ui.view">
        <field name="name">brightloop.quotation.template.list</field>
        <field name="model">brightloop.quotation.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="duration_months"/>
            </list>
        </field>
    </record>

    <record id="view_brightloop_template_form" model="ir.ui.view">
        <field name="name">brightloop.quotation.template.form</field>
        <field name="model">brightloop.quotation.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Starter Package"/></h1>
                    </div>
                    <group>
                        <field name="plan_id"/>
                        <field name="duration_months"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="discount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brightloop_template" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">brightloop.quotation.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_brightloop_templates" name="Templates" parent="menu_brightloop_root"
              action="action_brightloop_template" sequence="30"
              groups="group_brightloop_staff,group_brightloop_admin"/>

    <record id="view_brightloop_subscription_form_extra" model="ir.ui.view">
        <field name="name">brightloop.subscription.form.extra</field>
        <field name="model">brightloop.subscription</field>
        <field name="inherit_id" ref="view_brightloop_subscription_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='plan_id']" position="before">
                <field name="template_id"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='unit_price']" position="after">
                <field name="discount"/>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group string="Payments" invisible="invoice_count == 0">
                    <field name="amount_invoiced" widget="monetary"/>
                    <field name="amount_paid" widget="monetary"/>
                    <field name="amount_due" widget="monetary"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>