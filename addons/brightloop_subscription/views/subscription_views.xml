<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_brightloop_subscription_list" model="ir.ui.view">
        <field name="name">brightloop.subscription.list</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-muted="state == 'closed'" decoration-warning="state == 'paused'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="next_billing_date"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_brightloop_subscription_form" model="ir.ui.view">
        <field name="name">brightloop.subscription.form</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_quote" string="Create Quotation" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'quotation'"/>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_pause" string="Pause" type="object" invisible="state != 'active'"/>
                    <button name="action_resume" string="Resume" type="object" invisible="state != 'paused'"/>
                    <button name="action_renew" string="Renew" type="object" invisible="state != 'active'"/>
                    <button name="action_close" string="Close" type="object" invisible="state in ('draft', 'closed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,quotation,confirmed,active,closed"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="plan_id"/>
                            <field name="payment_term_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="next_billing_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="History">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="from_state"/>
                                    <field name="to_state"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_brightloop_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">brightloop.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_brightloop_subscriptions" name="Subscriptions"
              parent="menu_brightloop_root"
              action="action_brightloop_subscription" sequence="20"/>
</odoo>
