<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_brightloop_invoices" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('subscription_id', '=', active_id)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="view_brightloop_subscription_list" model="ir.ui.view">
        <field name="name">brightloop.subscription.list</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="plan_id"/>
                <field name="start_date" optional="show"/>
                <field name="next_billing_date" optional="show"/>
                <field name="expiry_date" optional="hide"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'paused'"
                       decoration-info="state in ('quotation', 'confirmed')"
                       decoration-muted="state in ('draft', 'closed')"/>
            </list>
        </field>
    </record>

    <record id="view_brightloop_subscription_form" model="ir.ui.view">
        <field name="name">brightloop.subscription.form</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_quote" type="object" string="Send Quotation"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'quotation'"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_run_billing" type="object" string="Run Billing"
                            invisible="state != 'active'"/>
                    <button name="action_renew" type="object" string="Renew"
                            invisible="state != 'active'"/>
                    <button name="action_pause" type="object" string="Pause"
                            invisible="state != 'active'"/>
                    <button name="action_resume" type="object" string="Resume"
                            class="btn-primary" invisible="state != 'paused'"/>
                    <button name="action_close" type="object" string="Close"
                            confirm="Close this subscription?"
                            invisible="state in ('closed',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,quotation,confirmed,active,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Closed" bg_color="text-bg-secondary"
                            invisible="state != 'closed'"/>
                    <field name="is_overdue" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_brightloop_invoices)d" type="action"
                                class="oe_stat_button" icon="fa-file-text-o"
                                groups="account.group_account_invoice"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="customer_id"/>
                            <field name="plan_id"/>
                            <field name="payment_term_id"/>
                        </group>
                        <group string="Dates">
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="next_billing_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="price_tax" widget="monetary" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <field name="amount_total" widget="monetary"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="History" name="history">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="from_state" widget="badge"/>
                                    <field name="to_state" widget="badge"/>
                                    <field name="user_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_brightloop_subscription_search" model="ir.ui.view">
        <field name="name">brightloop.subscription.search</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="plan_id"/>
                <filter name="f_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="f_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="f_paused" string="Paused" domain="[('state', '=', 'paused')]"/>
                <filter name="f_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="f_due" string="Due for Billing"
                        domain="[('state', '=', 'active'), ('next_billing_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="f_overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    <filter name="g_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_brightloop_subscription_graph" model="ir.ui.view">
        <field name="name">brightloop.subscription.graph</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="plan_id"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_brightloop_subscription_pivot" model="ir.ui.view">
        <field name="name">brightloop.subscription.pivot</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="plan_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_brightloop_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">brightloop.subscription</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first subscription</p>
            <p>Pick a customer and a plan, add lines, then confirm and activate it to start billing.</p>
        </field>
    </record>

    <menuitem id="menu_brightloop_subscriptions" name="Subscriptions"
              parent="menu_brightloop_root" action="action_brightloop_subscription"
              sequence="10" groups="group_brightloop_staff,group_brightloop_admin"/>
</odoo>