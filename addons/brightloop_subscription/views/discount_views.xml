<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_brightloop_discount_list" model="ir.ui.view">
        <field name="name">brightloop.discount.rule.list</field>
        <field name="model">brightloop.discount.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="discount_type"/>
                <field name="value"/>
                <field name="apply_on"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="usage_count"/>
                <field name="usage_limit"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_brightloop_discount_form" model="ir.ui.view">
        <field name="name">brightloop.discount.rule.form</field>
        <field name="model">brightloop.discount.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Volume discount"/></h1>
                    </div>
                    <group>
                        <group string="Discount">
                            <field name="discount_type"/>
                            <field name="value"/>
                            <field name="apply_on"/>
                            <field name="product_ids" widget="many2many_tags"
                                   invisible="apply_on != 'product'"
                                   required="apply_on == 'product'"/>
                        </group>
                        <group string="Conditions">
                            <field name="min_amount"/>
                            <field name="min_quantity"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="usage_limit"/>
                            <field name="usage_count"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brightloop_discount" model="ir.actions.act_window">
        <field name="name">Discount Rules</field>
        <field name="res_model">brightloop.discount.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_brightloop_discounts" name="Discount Rules" parent="menu_brightloop_root"
              action="action_brightloop_discount" sequence="35"
              groups="group_brightloop_admin"/>
</odoo>