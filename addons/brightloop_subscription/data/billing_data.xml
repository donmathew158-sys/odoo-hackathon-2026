<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_brightloop_billing" model="ir.cron">
            <field name="name">Brightloop: Run Recurring Billing</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_billing()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>

    <record id="action_brightloop_run_billing" model="ir.actions.server">
        <field name="name">Run Billing</field>
        <field name="model_id" ref="model_brightloop_subscription"/>
        <field name="binding_model_id" ref="model_brightloop_subscription"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_run_billing()</field>
    </record>
</odoo>
